#!/usr/bin/env python3
"""Check or synchronize the five owned files of the reviewed weekly skill."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile


SKILL_NAME = "stock-analyst-weekly-refresh"
OWNED_FILES = (
    "SKILL.md",
    "agents/openai.yaml",
    "references/weekly-contract.md",
    "scripts/reconcile_manifest.py",
    "tests/test_reconcile_manifest.py",
)


def _safe_path(root: Path, name: str) -> Path:
    if root.is_symlink():
        raise ValueError("skill directory must not be a symlink")
    path = root
    for part in Path(name).parts:
        path = path / part
        if path.is_symlink():
            raise ValueError("owned skill paths must not be symlinks")
    return path


def read_bundle(root: Path, *, required: bool) -> dict[str, tuple[bytes, int]]:
    if root.exists() and not root.is_dir():
        raise ValueError("skill destination must be a directory")
    result = {}
    for name in OWNED_FILES:
        path = _safe_path(root, name)
        if not path.exists():
            if required:
                raise ValueError("canonical skill bundle is incomplete")
            continue
        if not path.is_file():
            raise ValueError("owned skill entry must be a regular file")
        result[name] = (path.read_bytes(), path.stat().st_mode & 0o777)
    return result


def bundle_digest(bundle: dict[str, tuple[bytes, int]]) -> str:
    if not bundle:
        return "absent"
    digest = hashlib.sha256()
    for name in OWNED_FILES:
        digest.update(name.encode("utf-8") + b"\0")
        if name in bundle:
            content, _mode = bundle[name]
            digest.update(hashlib.sha256(content).digest())
        else:
            digest.update(b"missing")
    return digest.hexdigest()


def check_bundle(source: Path, destination: Path) -> dict:
    canonical = read_bundle(source, required=True)
    installed = read_bundle(destination, required=False)
    differing = [
        name for name in OWNED_FILES
        if name not in installed or canonical[name][0] != installed[name][0]
    ]
    return {
        "status": "synchronized" if not differing else "drifted",
        "ok": not differing,
        "ownedFileCount": len(OWNED_FILES),
        "sourceDigest": bundle_digest(canonical),
        "installedDigest": bundle_digest(installed),
        "differingFiles": differing,
        "unownedFilesPreserved": True,
    }


def _replace_file(path: Path, content: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_name = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, prefix=".weekly-skill-", delete=False) as temporary:
            temporary_name = Path(temporary.name)
            temporary.write(content)
            temporary.flush()
            os.fsync(temporary.fileno())
        temporary_name.chmod(mode)
        os.replace(temporary_name, path)
        temporary_name = None
    finally:
        if temporary_name is not None:
            temporary_name.unlink(missing_ok=True)


def install_bundle(
    source: Path,
    destination: Path,
    *,
    expected_source_digest: str,
    expected_installed_digest: str,
) -> dict:
    canonical = read_bundle(source, required=True)
    installed = read_bundle(destination, required=False)
    if bundle_digest(canonical) != expected_source_digest:
        raise ValueError("canonical skill changed since review; recheck before installation")
    if bundle_digest(installed) != expected_installed_digest:
        raise ValueError("installed skill changed since inspection; preserve it and recheck")
    destination.parent.mkdir(parents=True, exist_ok=True)
    lock = destination.parent / ("." + destination.name + ".install.lock")
    lock_fd = os.open(lock, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    changed = []
    try:
        # Recheck after acquiring the installer lock, before the first replacement.
        if bundle_digest(read_bundle(destination, required=False)) != expected_installed_digest:
            raise ValueError("installed skill changed before synchronization")
        for name in OWNED_FILES:
            if name in installed and installed[name][0] == canonical[name][0]:
                continue
            path = _safe_path(destination, name)
            _replace_file(path, *canonical[name])
            changed.append(name)
        result = check_bundle(source, destination)
        if not result["ok"]:
            raise ValueError("installed skill failed exact-byte verification")
        result["changedFileCount"] = len(changed)
        return result
    except BaseException:
        # Restore only files this operation replaced; never delete another skill
        # or an unowned installed file. Rollback failure remains visible.
        for name in reversed(changed):
            path = _safe_path(destination, name)
            if name in installed:
                _replace_file(path, *installed[name])
            else:
                path.unlink(missing_ok=True)
        raise
    finally:
        os.close(lock_fd)
        lock.unlink(missing_ok=True)


def validate_reviewed_source(repo: Path, source_commit: str) -> str:
    actual = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repo, text=True).strip()
    if actual != source_commit:
        raise ValueError("checkout HEAD differs from the reviewed source commit")
    scope = ["skills/" + SKILL_NAME, "scripts/install-weekly-skill"]
    dirty = subprocess.check_output(["git", "status", "--porcelain", "--", *scope], cwd=repo, text=True)
    if dirty.strip():
        raise ValueError("canonical skill or installer has uncommitted changes")
    tracked = subprocess.check_output(["git", "ls-files", "--", scope[0]], cwd=repo, text=True)
    expected = {scope[0] + "/" + name for name in OWNED_FILES}
    if set(tracked.splitlines()) != expected:
        raise ValueError("tracked skill files differ from the owned bundle contract")
    return actual


def main() -> int:
    repo = Path(__file__).resolve().parent.parent
    source = repo / "skills" / SKILL_NAME
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true", help="read-only exact-byte drift check")
    mode.add_argument("--install", action="store_true", help="replace only owned files from a reviewed commit")
    codex_root = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    parser.add_argument("--destination", type=Path, default=codex_root / "skills" / SKILL_NAME)
    parser.add_argument("--source-commit")
    parser.add_argument("--expected-source-digest")
    parser.add_argument("--expected-installed-digest")
    args = parser.parse_args()
    try:
        if args.check:
            result = check_bundle(source, args.destination)
        else:
            if not all((args.source_commit, args.expected_source_digest, args.expected_installed_digest)):
                parser.error("--install requires --source-commit and both expected digests from --check")
            commit = validate_reviewed_source(repo, args.source_commit)
            result = install_bundle(
                source, args.destination,
                expected_source_digest=args.expected_source_digest,
                expected_installed_digest=args.expected_installed_digest,
            )
            result["sourceCommit"] = commit
        print(json.dumps(result, sort_keys=True))
        return 0 if result["ok"] else 1
    except (OSError, ValueError, subprocess.CalledProcessError):
        # Do not expose account paths or command stderr through application JSON.
        print(json.dumps({"ok": False, "status": "blocked", "reason": "skill synchronization precondition or file operation failed"}))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
