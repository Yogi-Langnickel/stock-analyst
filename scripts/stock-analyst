#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -n "${STOCK_ANALYST_PYTHON:-}" ]]; then
  PYTHON_BIN="${STOCK_ANALYST_PYTHON}"
elif [[ -x "${ROOT_DIR}/.venv/bin/python" ]]; then
  PYTHON_BIN="${ROOT_DIR}/.venv/bin/python"
elif command -v python3.13 >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python3.13)"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python3)"
else
  echo "No Python interpreter found. Create .venv or set STOCK_ANALYST_PYTHON." >&2
  exit 127
fi

export PYTHONPATH="${ROOT_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-${ROOT_DIR}/.pycache}"

usage() {
  cat <<'EOF'
Usage:
  scripts/stock-analyst which-python
  scripts/stock-analyst compile
  scripts/stock-analyst test
  scripts/stock-analyst cli <stock_analyst.cli args...>
  scripts/stock-analyst corpus-status [issues-folder]
  scripts/stock-analyst workbook-export-plan <pdf> [args...]
  scripts/stock-analyst refinement-plan <pdf> [args...]
  scripts/stock-analyst recommendation-cards <pdf> [args...]
  scripts/stock-analyst section-inventory <pdf> [args...]
  scripts/stock-analyst dividend-strategy <pdf> [args...]
  scripts/stock-analyst quick-check <pdf> [args...]
  scripts/stock-analyst chart-check <pdf> [args...]
  scripts/stock-analyst visual-ocr-review <pdf> [--page N] [--render] [--ocr]
  scripts/stock-analyst ocr-fixture-plan [--pdf private.pdf] [--artifact-dir path]
  scripts/stock-analyst ocr-needed <manifest.jsonl> [args...]
  scripts/stock-analyst market-data-plan [--env-file .env] [--symbol TICKER] [--symbol-file path]
  scripts/stock-analyst market-symbol-map-template --workbook-plan-file path --output path
  scripts/stock-analyst google-sheets-clear-data [--env-file .env]
  scripts/stock-analyst google-sheets-refresh-search [--env-file .env]
  scripts/stock-analyst google-sheets-export-plan <workbook-plan.json> [--env-file .env]
  scripts/stock-analyst google-sheets-refinement <pdf> [--env-file .env]
  scripts/stock-analyst python <python args...>

The wrapper prefers .venv/bin/python when present. It does not need shell
activation and keeps PYTHONPATH pointed at ./src for local commands.
EOF
}

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

COMMAND="$1"
shift

case "${COMMAND}" in
  which-python)
    echo "${PYTHON_BIN}"
    ;;
  compile)
    cd "${ROOT_DIR}"
    "${PYTHON_BIN}" -m compileall src tests
    ;;
  test)
    cd "${ROOT_DIR}"
    "${PYTHON_BIN}" -m unittest discover tests
    ;;
  cli)
    cd "${ROOT_DIR}"
    "${PYTHON_BIN}" -m stock_analyst.cli "$@"
    ;;
  workbook-export-plan|refinement-plan|recommendation-cards|section-inventory|dividend-strategy|quick-check|chart-check|visual-ocr-review|ocr-fixture-plan|ocr-needed|market-data-plan|market-symbol-map-template|process-pdf|import-pdf-folder|corpus-status|extraction-quality-report|review-queue|google-access-smoke|google-drive-pdfs|google-sheets-bootstrap|google-sheets-clear-data|google-sheets-refresh-search|google-sheets-export-plan|google-sheets-refinement)
    cd "${ROOT_DIR}"
    "${PYTHON_BIN}" -m stock_analyst.cli "${COMMAND}" "$@"
    ;;
  python)
    cd "${ROOT_DIR}"
    "${PYTHON_BIN}" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: ${COMMAND}" >&2
    usage >&2
    exit 2
    ;;
esac
