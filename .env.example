# Copy to .env for local development. Do not commit real values.

STOCK_ANALYST_ENV=local
STOCK_ANALYST_DATABASE_URL=sqlite:///./data/stock-analyst.sqlite3
STOCK_ANALYST_UPLOAD_DIR=./data/uploads
STOCK_ANALYST_EXPORT_DIR=./data/exports
STOCK_ANALYST_MARKET_DATA_PROVIDER=fmp
STOCK_ANALYST_MARKET_DATA_CACHE_DIR=./data/market-cache
STOCK_ANALYST_MARKET_DATA_DAILY_CALL_LIMIT=235
STOCK_ANALYST_MARKET_DATA_TERMS_VERSION=fmp-personal-basic-reviewed-YYYY-MM-DD

# Optional local dry-run FMP planning. Keep real keys only in .env.
FMP_API_KEY=

# Optional later integrations.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
