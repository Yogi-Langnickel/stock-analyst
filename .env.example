# Copy to .env for local development. Do not commit real values.

STOCK_ANALYST_ENV=local
STOCK_ANALYST_DATABASE_URL=sqlite:///./data/stock-analyst.sqlite3
STOCK_ANALYST_UPLOAD_DIR=./data/uploads
STOCK_ANALYST_EXPORT_DIR=./data/exports
STOCK_ANALYST_MARKET_DATA_PROVIDER=fmp
STOCK_ANALYST_MARKET_DATA_CACHE_DIR=./data/market-cache
STOCK_ANALYST_MARKET_DATA_BUDGET_DIR=./data/market-cache/_budgets
STOCK_ANALYST_MARKET_DATA_DAILY_CALL_LIMIT=235
STOCK_ANALYST_MARKET_DATA_TERMS_VERSION=fmp-personal-basic-reviewed-YYYY-MM-DD
STOCK_ANALYST_WORKBOOK_PLAN_FILE=./data/private/workbook-plan.json
STOCK_ANALYST_SYMBOL_MAP_FILE=./data/private/market-symbol-map.csv

# Optional local dry-run provider planning. Keep real keys only in .env. Live
# enrichment must be sourced from magazine-backed workbook rows, not arbitrary
# symbols.
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
FINNHUB_SECRET=
TWELVEDATA_API_KEY=

# SEC EDGAR public-data access. No API key is required. Use a monitored email;
# a bare email is normalized to "Stock Analyst <email>" for the User-Agent.
SEC_USER_AGENT=
STOCK_ANALYST_SEC_CACHE_DIR=./data/market-cache/sec-edgar
STOCK_ANALYST_INSIDER_LOOKBACK_DAYS=365
STOCK_ANALYST_SEC_MAX_REQUESTS=100

# Optional later integrations.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
